<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="{{ description or 'Kouassi H. — regards sur le sport, la culture et la société.' }}">
<meta name="theme-color" content="#123b2e">
<title>{{ title }} | Kouassi H.</title>
<style>
:root {--g: #00101F;--gold: #E2A21E;--cream: #F7F3EA;--ink: #00101F;--muted: #59616B;--line: #E5DCCB;}
{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font:18px/1.7 Georgia,"Times New Roman",serif}
.wrap{width:min(1100px,92%);margin:auto}header,.hero{background:var(--g);color:#fff}.mast{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0}
.brand{font:800 1.5rem Arial,sans-serif;...
.brand .site-logo {display: block;width: 150px;height: auto; max-height: 90px;object-fit: contain;}
nav{display:flex;gap:18px;flex-wrap:wrap;font:600 .9rem Arial,sans-serif}nav a{color:#fff;text-decoration:none}
.hero{padding:45px 0}.eyebrow{font:700 .75rem Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase}
h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.1;max-width:900px;margin:16px 0}.dek{font-size:1.15rem;max-width:780px;color:#e2e9e2}
.meta{font:.85rem Arial,sans-serif;color:#d6e0d7;margin-top:22px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
button,.button{border:1px solid var(--gold);background:var(--gold);color:#17291f;padding:10px 14px;border-radius:3px;cursor:pointer;text-decoration:none;font:600 .9rem Arial,sans-serif}
.button.secondary{background:transparent;color:#fff}main{padding:42px 0 65px}.story{background:#fff;border:1px solid var(--line);padding:clamp(22px,4vw,45px)}
.story h2{color:var(--g);font-size:1.7rem;line-height:1.25;margin:1.7em 0 .55em}.story p{margin:0 0 1.1em}.lead{font-size:1.22rem;border-left:4px solid var(--gold);padding-left:18px;color:#39463c}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{background:#fff;border:1px solid var(--line);display:flex;flex-direction:column}
.card-body{padding:23px}.category{font:700 .72rem Arial,sans-serif;color:#92743b;letter-spacing:.12em;text-transform:uppercase}
.card h2{color:var(--g);font-size:1.45rem;line-height:1.25;margin:10px 0}.card p{color:var(--muted);font-size:.97rem}
.card-foot{margin-top:auto;border-top:1px solid #f0ede5;padding:15px 23px;display:flex;justify-content:space-between;gap:10px;font:600 .85rem Arial,sans-serif}.card-foot a{color:var(--g);text-decoration:none}
.tools{display:flex;gap:12px;flex-wrap:wrap;margin:10px 0 24px}.tools input,.tools select{padding:12px;border:1px solid var(--line);background:#fff;font:1rem Arial,sans-serif;border-radius:3px}.tools input{flex:1;min-width:210px}
.about{background:#eae7dc;padding:42px 0}.about h2{color:var(--g)}footer{background:#0c2b21;color:#dce5dc;padding:25px 0;font:.85rem Arial,sans-serif}footer a{color:var(--gold)}
@media(max-width:780px){.mast{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{padding:35px 0}}
@media(max-width:540px){.grid{grid-template-columns:1fr}}
@media print{header,.actions,footer{display:none}.hero{background:#fff;color:#000}.dek,.meta{color:#333}}
</style>
</head>
<body>
<header><div class="wrap mast"><a class="brand" href="/" aria-label="Kouassi H. — Accueil">
  <img src="/images/logo-kouassi-h.png" alt="Kouassi H. — Les talents ont une histoire." class="site-logo">
</a><nav aria-label="Navigation"><a href="/">Accueil</a><a href="/#articles">Articles</a><a href="/#sport">Sport</a><a href="/#apropos">À propos</a></nav></div></header>
{{ content | safe }}
<footer><div class="wrap">© {{ "now" | dateFr }} Kouassi H. — Tous droits réservés. · <a href="/">Retour à l’accueil</a></div></footer>
</body></html>
